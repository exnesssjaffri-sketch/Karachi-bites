PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-random-32-byte-secret

# Database configuration: SQLite (default) or PostgreSQL
# DATABASE_PATH is used for SQLite (relative to project root)
DATABASE_PATH=./karachi_bites.db
# Set to 'true' to force PostgreSQL even in development
USE_SQLITE=true
# DATABASE_URL is required when USE_SQLITE=false (production)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@localhost:5432/karachi_bites

DELIVERY_FEE=150
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
STAFF_USERNAME=your-staff-username
STAFF_PASSWORD=replace-with-a-unique-12-plus-character-password
