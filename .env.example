PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-random-32-byte-secret

# Database configuration: SQLite (default, development only) or PostgreSQL (production)
# DATABASE_PATH is used for SQLite (relative to project root)
DATABASE_PATH=./karachi_bites.db
# Set to 'true' to use SQLite; set to 'false' to require PostgreSQL (production)
USE_SQLITE=true
# DATABASE_URL is REQUIRED when USE_SQLITE=false. There is no silent fallback to SQLite.
# Format: postgresql://user:password@host:5432/database
# Placeholders only — never commit a real connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/karachi_bites
# PG_TEST_DATABASE_URL is used ONLY by test/test_persistence_pg.js (a dedicated
# test database, never a production one). If unset, that test reports NOT RUN.
PG_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/karachi_bites_test

DELIVERY_FEE=150
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
STAFF_USERNAME=your-staff-username
STAFF_PASSWORD=replace-with-a-unique-12-plus-character-password
